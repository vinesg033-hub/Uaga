{
  "namespace": "pause",
  "pause_button@common_buttons.simple_button": {
    "size": [ 160, 25 ],
    "$button_text_color": "$color_text_main"
  },
  "pause_screen_content": {
    "type": "panel",
    "controls": [
      {
        "stack": {
          "type": "stack_panel",
          "size": [ 160, "100%c" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "title": {
                "type": "panel",
                "size": [ "100%", 40 ],
                "controls": [
                  {
                    "l": {
                      "type": "label",
                      "text": "GAME PAUSED",
                      "color": "$color_secondary",
                      "shadow": true,
                      "size": [ "default", 10 ]
                    }
                  }
                ]
              }
            },
            { "res": { "type": "panel", "size": [ "100%", 25 ], "controls": [ { "b@pause.pause_button": { "$button_text": "Resume", "$pressed_button_name": "button.menu_continue" } } ] } },
            { "sp1": { "type": "panel", "size": [ "100%", 5 ] } },
            { "set": { "type": "panel", "size": [ "100%", 25 ], "controls": [ { "b@pause.pause_button": { "$button_text": "Settings", "$pressed_button_name": "button.menu_settings" } } ] } },
            { "sp2": { "type": "panel", "size": [ "100%", 5 ] } },
            { "quit": { "type": "panel", "size": [ "100%", 25 ], "controls": [ { "b@pause.pause_button": { "$button_text": "Save & Quit", "$pressed_button_name": "button.menu_quit" } } ] } }
          ]
        }
      }
    ]
  },
  "pause_screen@common.base_screen": {
    "is_showing_menu": true,
    "should_steal_mouse": true,
    "$screen_bg_content": "common_buttons.empty_panel",
    "$screen_content": "pause.pause_screen_content"
  }
}