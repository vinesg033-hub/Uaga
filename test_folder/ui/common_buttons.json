{
  "namespace": "common_buttons",
  "empty_panel": {
    "type": "panel",
    "size": [ 0, 0 ]
  },
  "button@common.button": {
    "$button_texture": "$button_texture_default",
    "$hover_texture": "$button_texture_hover",
    "$pressed_texture": "$button_texture_pressed",
    "$button_nineslice": "$button_nineslice",
    "$button_color": "$color_main",
    "$hover_color": "$color_main",
    "$pressed_color": "$color_secondary"
  },
  "light_content_button@common.button": {
    "$button_texture": "$button_texture_default",
    "$hover_texture": "$button_texture_hover",
    "$pressed_texture": "$button_texture_pressed",
    "$button_nineslice": "$button_nineslice",
    "$button_color": "$color_main",
    "$hover_color": "$color_main",
    "$pressed_color": "$color_secondary"
  },
  "light_glyph_button@common.button": {
    "$button_texture": "$button_texture_default",
    "$hover_texture": "$button_texture_hover",
    "$pressed_texture": "$button_texture_pressed",
    "$button_nineslice": "$button_nineslice",
    "$button_color": "$color_main",
    "$hover_color": "$color_main",
    "$pressed_color": "$color_secondary"
  },
  "simple_button@common.button": {
    "size": "$button_size",
    "controls": [
      {
        "default": {
          "type": "image",
          "texture": "$button_texture_default",
          "nineslice_size": "$button_nineslice",
          "color": "$color_main",
          "alpha": "$button_alpha_default",
          "layer": 10,
          "size": [ "100%", "100%" ]
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "$button_texture_hover",
          "nineslice_size": "$button_nineslice",
          "color": "$color_main",
          "alpha": "$button_alpha_hover",
          "layer": 11,
          "size": [ "100%", "100%" ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "$button_texture_pressed",
          "nineslice_size": "$button_nineslice",
          "color": "$color_secondary",
          "alpha": "$button_alpha_pressed",
          "layer": 12,
          "size": [ "100%", "100%" ]
        }
      },
      {
        "border": {
          "type": "image",
          "texture": "$button_texture_border",
          "nineslice_size": "$button_nineslice",
          "color": "$color_main",
          "layer": 13,
          "size": [ "100%", "100%" ]
        }
      },
      {
        "text_label": {
          "type": "label",
          "text": "$button_text",
          "shadow": true,
          "layer": 15,
          "color": "$color_text_main",
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },
  "light_text_button@common.button": {
    "$button_texture": "$button_texture_default",
    "$hover_texture": "$button_texture_hover",
    "$pressed_texture": "$button_texture_pressed",
    "$button_nineslice": "$button_nineslice",
    "$button_color": "$color_main",
    "$hover_color": "$color_main",
    "$pressed_color": "$color_secondary"
  },
  "light_text_form_fitting_button@common.button": {
    "$button_texture": "$button_texture_default",
    "$hover_texture": "$button_texture_hover",
    "$pressed_texture": "$button_texture_pressed",
    "$button_nineslice": "$button_nineslice",
    "$button_color": "$color_main",
    "$hover_color": "$color_main",
    "$pressed_color": "$color_secondary"
  },
  "quick_craft_button@common.button": {
    "size": [ 26, 26 ],
    "layer": 5,
    "$pressed_button_name": "button.quickcraft"
  },
  "bt_quick_crafting": {
    "quick_craft_button": {
      "size": [ 26, 26 ],
      "layer": 5,
      "$pressed_button_name": "button.quickcraft"
    }
  },
  "quick_trade_button@common.button": {
    "size": [ 26, 26 ],
    "layer": 5,
    "$pressed_button_name": "button.quickcraft"
  },
  "stonecutter_quick_craft_button@common.button": {
    "size": [ 26, 26 ],
    "layer": 5,
    "$pressed_button_name": "button.quickcraft"
  }
}